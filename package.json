{
  "name": "madness-engine",
  "version": "0.1.0",
  "description": "An engine for rolling games: a WebGPU/WebGL2 renderer, ball physics, controls, camera, stage, sound, effects and the sculpting kit, with a library of every character, prop, hero, texture and song the games have made",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    "./gfx": "./src/gfx/index.js",
    "./characters": "./src/characters/index.js",
    "./props": "./src/props/index.js",
    "./moods": "./src/moods/index.js",
    "./*.js": "./src/*.js",
    "./*": "./src/*.js"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint .",
    "verify": "node scripts/verify-drop-in.mjs",
    "extract": "node scripts/extract/library.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.13.0"
  }
}
